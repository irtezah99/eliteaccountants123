# Copy this file to .env and fill in your own values.

# Local database file (SQLite) - no setup needed, this just creates a file on disk.
DATABASE_URL="file:./dev.db"

# A random secret used to sign login sessions. Any long random string works.
# You can generate one at https://generate-secret.vercel.app/32
SESSION_SECRET="replace-this-with-a-long-random-string"

# The very first admin account is created by the seed script using these values.
ADMIN_EMAIL="admin@pakbusshub.com"
ADMIN_PASSWORD="ChangeMe123!"
